    "042": ["吓我一跳！", "耳朵都竖起来啦！", "突然出现！"],
    "092": ["哇——！", "冷静，冷静！", "我抖一抖。"],
    "108": ["伸个懒腰！", "长高一点点。", "嘿咻！"],
    "111": ["咦？发生什么啦？", "张嘴小惊讶！", "我听见你叫我啦。"],
    "113": ["落地！", "我压扁了……", "还好有弹性。"],
    "127": ["滚一圈回来！", "咕噜咕噜～", "别担心，我没事。"],
    "135": ["翻个身！", "我又站起来啦。", "重新出发！"]
    ,"019": ["洗得香喷喷～", "耳朵也擦干净啦！"],
    "030": ["一起玩呀！", "接住我～"],
    "034": ["再来一局！", "今天状态不错～"],
    "035": ["眼泪流成小水洼了……", "今天有一点难过。"],
    "037": ["我出现啦！", "醒来见到你啦～"],
    "088": ["开饭啦！", "我会好好吃饭的～"],
    "118": ["有一点累了……", "让我歇一会儿吧。"],
    "120": ["想吃点东西～", "饭碗是不是空啦？"],
    "125": ["玩得好开心！", "再跑一圈～"],
    "147": ["吃饱啦！", "谢谢投喂～"],
    "150": ["吃过药会好起来的。", "谢谢你照顾我。"],
    "158": ["要洗澡了吗？", "水温刚刚好～"],
    "162": ["小零食！", "只吃一点点～"],
    "179": ["跑起来啦！", "今天也要活动一下～"],
    "160": ["抱在一起睡觉最安心。", "呼噜……呼噜……"],

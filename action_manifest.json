  "dialogues": {
    "004": ["跳起来啦！", "再跳一次！", "弹弹弹～"],
    "018": ["看到你啦！", "挥挥小爪～", "你好呀！"],
    "029": ["咦，发生什么啦？", "让我想想……", "你在叫我吗？"],
    "031": ["收到！", "没问题！", "交给我吧。"],
